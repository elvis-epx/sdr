#!/bin/sh -x

# Record 100 seconds of broadcast FM and decode RDS.
# Saves the baseband to teste_rds.raw for later tests.

rtl_sdr -f 91.5M -s 256k -n 25600000 teste.iq
cat teste.iq | ./fm1.py > teste.raw
sox -t raw -r 256000 -b 16 -c 1 -L -e signed-integer teste.raw teste.wav
cat teste.raw | ./fm_rds.py
